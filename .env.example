# FinPilot - environment configuration example.
# Copy to `.env` and fill in your values. Never commit `.env`.

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Google Gemini API key (server-side only - never exposed to the frontend).
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20

# ── Data source / MCP ─────────────────────────────────────────────────────────
# "mcp"  -> use the standalone MCP servers (auto-spawned stdio, or remote SSE)
# "mock" -> read deterministic mock data directly (offline / reliable fallback)
DATA_SOURCE=mcp
# stdio = backend spawns the MCP servers as subprocesses; sse = connect over HTTP
MCP_TRANSPORT=stdio
MCP_TIMEOUT_SECONDS=5
MCP_MAX_RETRIES=2

# When MCP_TRANSPORT=sse, the backend connects to these SSE endpoints.
BANK_MCP_URL=http://127.0.0.1:9001/sse
MARKET_MCP_URL=http://127.0.0.1:9002/sse
LOAN_MCP_URL=http://127.0.0.1:9003/sse

# ── Operational budget guard ──────────────────────────────────────────────────
BUDGET_MAX_TOOL_CALLS=8
BUDGET_MAX_COST_USD=0.05

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Risk observer thresholds ──────────────────────────────────────────────────
RISK_LIQUIDITY_MIN_BALANCE=25000
RISK_LARGE_DEBIT_THRESHOLD=50000
RISK_LARGE_CREDIT_THRESHOLD=50000
RISK_EMI_BURDEN_RATIO=0.5
RISK_CREDIT_UTILIZATION_THRESHOLD=0.7
RISK_UNUSUAL_SPEND_THRESHOLD=0.35

# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8000
ENABLE_SSE_EVENTS=true
# Comma separated list of allowed frontend origins (default *)
ALLOWED_ORIGINS=*
